# 효성ITX AX Review — 환경 변수 (.gitignore 대상)

# Gemini (AX 관련도 채점·노트 초안·주간 흐름) — AI_NEWS와 같은 키, 콤마로 여러 개 넣으면 로테이션
GEMINI_API_KEYS=

# 네이버 뉴스 검색 API (없으면 네이버 수집만 건너뜀) — AI_NEWS와 같은 키
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 뉴스레터 메일 발송 (SMTP) — 비어 있으면 발송 기능만 꺼짐
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# starttls / ssl / none
SMTP_TLS=starttls

# 메일 안 링크(노트·구독 해지)에 쓰는 사이트 주소
SITE_URL=http://localhost:5002


# Databricks 적재 (Trade_IQ와 같은 연결, 2026-10-28)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# 이 프로젝트 전용 Databricks 스키마 (Streamlit 판 axreview 와 분리)
DATABRICKS_SCHEMA=axreview_react
# 관리 API 토큰 (브라우저 관리 화면이 X-Admin-Token 헤더로 보냄). 비우면 로컬·등록 IP 판정만 사용
ADMIN_TOKEN=
